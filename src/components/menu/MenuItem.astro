---
import type { CollectionEntry } from 'astro:content';

interface Props {
  item: CollectionEntry<'menu'>;
  index: number;
}

const { item, index } = Astro.props;
const { name, description, price, tags } = item.data;

const tagLabels: Record<string, string> = {
  'single-origin': 'single origin',
  blend: 'blend',
  oat: 'овсяное',
  decaf: 'decaf',
  signature: 'фишка',
  vegan: 'vegan',
  hot: 'горячее',
  cold: 'холодное',
};

const visibleTags = tags.filter((t) => t !== 'hot' && t !== 'cold');
---

<article
  class="menu-card group flex flex-col justify-between gap-5 border border-ink/10 bg-paper/60 p-6 hover:border-brass/50 hover:bg-paper"
  data-menu-card
  data-category={item.data.category}
  data-reveal
  style={`--reveal-delay: ${(index % 3) * 80}ms`}
>
  <div>
    <div class="flex items-start justify-between gap-4">
      <h3 class="font-display text-lg font-medium tracking-[-0.02em]">{name}</h3>
      <span class="menu-card-arrow text-brass opacity-0 transition-opacity duration-300 group-hover:opacity-100"
        >→</span
      >
    </div>
    <p class="mt-2 text-sm leading-relaxed text-ink-soft">{description}</p>
    {
      visibleTags.length > 0 && (
        <ul class="mt-4 flex flex-wrap gap-2">
          {visibleTags.map((tag) => (
            <li class="border border-ink/15 px-2.5 py-1 text-[0.65rem] tracking-wider uppercase text-ink-soft">
              {tagLabels[tag] ?? tag}
            </li>
          ))}
        </ul>
      )
    }
  </div>
  <div class="flex items-baseline justify-between border-t border-ink/10 pt-4">
    <span class="menu-card-price font-display text-xl font-semibold tabular-nums tracking-[-0.02em] transition-colors duration-500">
      {price} ₸
    </span>
    {
      item.data.featured && (
        <span class="text-[0.6rem] font-medium tracking-[0.2em] text-brass uppercase">
          выбор бариста
        </span>
      )
    }
  </div>
</article>
