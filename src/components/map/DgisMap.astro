---
import { site } from '../../lib/site';

const { lat, lng } = site.coords;
const bbox = `${lng - 0.006},${lat - 0.004},${lng + 0.006},${lat + 0.004}`;
const osmSrc = `https://www.openstreetmap.org/export/embed.html?bbox=${encodeURIComponent(bbox)}&layer=mapnik&marker=${lat}%2C${lng}`;
---

<div class="grid gap-8 lg:grid-cols-[1.4fr_1fr] lg:gap-12">
  <div
    class="relative min-h-[340px] overflow-hidden border border-ink/10 bg-paper-dim sm:min-h-[420px]"
    data-map-container
  >
    <!-- Static fallback (shown until map iframe loads) -->
    <div
      class="absolute inset-0 z-10 flex flex-col items-center justify-center gap-4 p-8 text-center transition-opacity duration-700"
      data-map-fallback
    >
      <div
        class="flex h-14 w-14 items-center justify-center rounded-full border border-brass text-brass"
        aria-hidden="true"
      >
        ✦
      </div>
      <p class="max-w-xs text-sm leading-relaxed text-ink-soft">
        {site.address} — первый этаж, вход со стороны бульвара.
      </p>
      <a
        href={site.mapUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="border border-ink/25 px-5 py-2.5 text-sm transition-colors hover:border-brass hover:text-brass"
      >
        Открыть маршрут в 2GIS →
      </a>
    </div>

    <!--
      OpenStreetMap embed instead of raw 2gis.kz iframe:
      2GIS serves an anti-bot reCAPTCHA page inside iframes for many IPs.
      Routing still goes to 2GIS (buttons below); swap to 2GIS JS API
      with PUBLIC_DGIS_KEY when a key is issued.
    -->
    <iframe
      src={osmSrc}
      title="Карта: ЖАР, Астана (OpenStreetMap)"
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      allowfullscreen
      class="absolute inset-0 h-full w-full border-0 opacity-0 transition-opacity duration-700"
      data-map-frame></iframe>
  </div>

  <div class="flex flex-col justify-center gap-6" data-reveal>
    <div>
      <p class="text-xs font-medium tracking-[0.25em] uppercase text-brass">Как нас найти</p>
      <p class="mt-3 font-display text-2xl leading-snug font-medium tracking-[-0.02em]">
        {site.address}
      </p>
    </div>

    <dl class="space-y-3 border-t border-ink/10 pt-6 text-sm">
      <div class="flex gap-4">
        <dt class="w-20 shrink-0 text-ink-soft/70">Часы</dt>
        <dd>{site.hours}</dd>
      </div>
      <div class="flex gap-4">
        <dt class="w-20 shrink-0 text-ink-soft/70">Телефон</dt>
        <dd>
          <a href={`tel:${site.phoneHref}`} class="transition-colors hover:text-brass"
            >{site.phone}</a
          >
        </dd>
      </div>
      <div class="flex gap-4">
        <dt class="w-20 shrink-0 text-ink-soft/70">Метро</dt>
        <dd>«Кабанбай батыра», 7 минут пешком</dd>
      </div>
    </dl>

    <div class="flex flex-wrap gap-3">
      <a
        href={site.mapUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-fill border border-night bg-night px-6 py-3 text-sm font-medium text-paper transition-colors duration-300 hover:text-night"
      >
        Маршрут в 2GIS
      </a>
      <a
        href={`tel:${site.phoneHref}`}
        class="border border-ink/25 px-6 py-3 text-sm font-medium transition-colors hover:border-brass hover:text-brass"
      >
        Позвонить
      </a>
    </div>
  </div>
</div>

<script>
  const frame = document.querySelector<HTMLIFrameElement>('[data-map-frame]');
  const fallback = document.querySelector<HTMLElement>('[data-map-fallback]');
  frame?.addEventListener('load', () => {
    frame.classList.remove('opacity-0');
    fallback?.classList.add('opacity-0', 'pointer-events-none');
  });
</script>
