---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/shared/Button.astro';
---

<BaseLayout title="404 — ЖАР" description="Страница не найдена">
  <main
    class="flex min-h-[100svh] flex-col items-center justify-center gap-6 px-6 text-center"
  >
    <p class="font-display text-[clamp(4rem,15vw,10rem)] leading-none font-semibold text-brass">
      404
    </p>
    <h1 class="font-display text-2xl font-medium tracking-[-0.02em]">
      Страница не найдена
    </h1>
    <p class="max-w-sm text-ink-soft">
      Похоже, эта страница остыла. Вернитесь на главную — там горячий кофе.
    </p>
    <Button href="/" variant="ghost">На главную</Button>
  </main>
</BaseLayout>
